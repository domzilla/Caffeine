/* Accessibility label for a duration menu item, %@ is the duration */
"Activate: %@" = "Aktivieren: %@";

/* Accessibility value announced when Caffeine is preventing sleep */
"Active, sleep prevented" = "Aktiv, Ruhezustand verhindert";

/* Accessibility value announced when Caffeine is not preventing sleep */
"Inactive, sleep allowed" = "Inaktiv, Ruhezustand erlaubt";
